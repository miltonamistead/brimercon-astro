---
/**
 * Stripe-style checkout MOCKUP for one Brimer Membership plan.
 *
 * VISUAL MOCKUP ONLY. Nothing here collects, stores, or submits any email,
 * card, or payment data: there is no <form>, every input and button is
 * disabled, and there are no card-number fields. Payments are not connected.
 *
 * The page is noindex, nofollow (meta robots) and carries the site NAP line
 * plus a demo notice in its footer so the QA gate (phone, NAP) stays green.
 */
import Schema from "@/components/Schema.astro";
import { site } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";
import type { CheckoutPlan } from "@/data/membership-checkout";
import "@/styles/global.css";

interface Props {
  plan: CheckoutPlan;
}

const { plan } = Astro.props;

const title = `Checkout: ${plan.tierName} membership (${plan.billingLabel}) | Brimer Plumbing`;
const description = `Demo checkout for Brimer Membership, ${plan.tierName} (${plan.billingLabel}). Payments are not connected and no payment information is collected.`;
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Membership", path: "/membership/" },
  { name: `Checkout: ${plan.tierName} (${plan.billingLabel})`, path: `/membership/checkout/${plan.slug}/` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Schema nodes={[breadcrumbSchema(crumbs)]} />
  </head>
  <body>
    <main class="checkout-page">
      <div class="checkout-wrap">
        <div class="checkout-grid">
          <section class="checkout-summary" aria-label="Order summary">
            <p class="checkout-back">
              <a href="/membership/">&larr; Back</a>
              <span class="checkout-brand">
                <img src="/images/brimer-logo.png" alt="" width="84" height="31" />
                <span>Brimer Plumbing</span>
              </span>
            </p>
            <h1>Subscribe to Brimer Membership: {plan.tierName} ({plan.billingLabel})</h1>
            <p class="checkout-price">
              <span class="checkout-price__amount">{plan.price}</span>
              <span class="checkout-price__per">{plan.perLabel}</span>
            </p>
            {plan.perMonthLine && <p class="checkout-permonth">{plan.perMonthLine}</p>}
            <div class="currency-toggle" role="group" aria-label="Currency">
              <button type="button" disabled aria-pressed="false">PHP</button>
              <button type="button" disabled aria-pressed="true" class="is-selected">USD</button>
            </div>
            <p class="currency-note">Your bank may apply exchange rates and fees.</p>
            <div class="line-items">
              <div class="line-item">
                <div>
                  <p class="line-item__name">Brimer Membership: {plan.tierName} ({plan.billingLabel})</p>
                  <p class="line-item__meta">{plan.billedNote}</p>
                </div>
                <p class="line-item__price">{plan.price}</p>
              </div>
              <div class="line-row">
                <span>Subtotal</span>
                <span>{plan.price}</span>
              </div>
              <div class="line-row">
                <button type="button" class="promo-btn" disabled>Add promotion code</button>
              </div>
              <div class="line-row line-row--total">
                <span>Total due today</span>
                <span>{plan.price}</span>
              </div>
            </div>
          </section>

          <section class="checkout-pay" aria-label="Payment">
            <div class="wallet-row">
              <button type="button" class="wallet wallet--apple" disabled aria-disabled="true">
                Apple Pay
              </button>
              <button type="button" class="wallet wallet--link" disabled aria-disabled="true">Link</button>
              <button type="button" class="wallet wallet--amazon" disabled aria-disabled="true">amazon pay</button>
            </div>
            <div class="or-divider" role="separator"><span>OR</span></div>
            <p class="field-label">Contact information</p>
            <label class="field">
              <span class="field__label">Email</span>
              <input type="email" placeholder="Email address" disabled autocomplete="off" />
            </label>
            <p class="field-label">Payment method</p>
            <div class="pay-methods">
              <label class="pay-method pay-method--selected">
                <input type="radio" name="pay-method" checked disabled />
                <span class="pay-method__name">Card</span>
                <span class="card-marks" aria-label="Visa, Mastercard, American Express, Discover">
                  <span class="card-mark card-mark--visa">VISA</span>
                  <span class="card-mark card-mark--mc" aria-hidden="true"><i></i><i></i></span>
                  <span class="card-mark card-mark--amex">AMEX</span>
                  <span class="card-mark card-mark--disc">DISCOVER</span>
                </span>
              </label>
              <label class="pay-method">
                <input type="radio" name="pay-method" disabled />
                <span class="pay-method__name">Cash App Pay</span>
                <span class="cashapp-mark" aria-hidden="true">$</span>
              </label>
            </div>
            <button type="button" class="subscribe-btn" disabled aria-disabled="true">Subscribe</button>
            <p class="auth-note">
              By subscribing, you authorize Brimer Plumbing to charge you in USD according to
              the terms until you cancel.
            </p>
            <p class="stripe-foot">Powered by stripe <span aria-hidden="true">|</span> Terms <span aria-hidden="true">|</span> Privacy</p>
          </section>
        </div>
        <p class="checkout-nap">
          {site.name}, {site.street}, {site.city}, {site.region} {site.postal}. Call <a href={site.phoneHref}>{site.phoneDisplay}</a>. CA CSLB License #: {site.cslb}.
        </p>
        <p class="checkout-demo">
          Demo page: payments are not connected. No payment information is collected here.
        </p>
      </div>
    </main>

    <style>
      .checkout-page {
        min-height: 100vh;
        background: #f6f9fc;
        color: #1a1f36;
        font-family: var(--font);
        padding: 2rem 1rem 3rem;
      }
      .checkout-wrap {
        max-width: 60rem;
        margin: 0 auto;
      }
      .checkout-grid {
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: 2.5rem;
        align-items: start;
      }
      .checkout-back {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0 0 1.5rem;
      }
      .checkout-back a {
        color: #1a1f36;
        font-size: 1.5rem;
        line-height: 1;
        text-decoration: none;
      }
      .checkout-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
      }
      .checkout-brand img {
        display: block;
        height: auto;
      }
      h1 {
        font-family: var(--font);
        font-size: 1.5rem;
        line-height: 1.3;
        margin: 0 0 1rem;
        color: #1a1f36;
      }
      .checkout-price {
        margin: 0;
        line-height: 1;
      }
      .checkout-price__amount {
        font-size: 2.75rem;
        font-weight: 800;
      }
      .checkout-price__per {
        margin-left: 0.4rem;
        font-size: 1.1rem;
        color: #4f566b;
      }
      .checkout-permonth {
        margin: 0.6rem 0 0;
        color: #4f566b;
      }
      .currency-toggle {
        display: inline-flex;
        margin-top: 1.5rem;
        border: 1px solid #cbd2dc;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
      }
      .currency-toggle button {
        border: 0;
        background: #fff;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #1a1f36;
        cursor: not-allowed;
      }
      .currency-toggle button.is-selected {
        background: #1a1f36;
        color: #fff;
      }
      .currency-note {
        margin: 0.6rem 0 0;
        font-size: 0.85rem;
        color: #4f566b;
      }
      .line-items {
        margin-top: 1.75rem;
        border-top: 1px solid #dfe3ea;
      }
      .line-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #dfe3ea;
      }
      .line-item__name {
        margin: 0;
        font-weight: 600;
      }
      .line-item__meta {
        margin: 0.25rem 0 0;
        font-size: 0.9rem;
        color: #4f566b;
      }
      .line-item__price {
        margin: 0;
        font-weight: 600;
        white-space: nowrap;
      }
      .line-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid #dfe3ea;
      }
      .line-row--total {
        font-weight: 700;
        font-size: 1.05rem;
        border-bottom: 0;
      }
      .promo-btn {
        border: 0;
        background: none;
        padding: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: #635bff;
        cursor: not-allowed;
      }
      .wallet-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
      }
      .wallet {
        border: 0;
        border-radius: 6px;
        padding: 0.75rem 0.5rem;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: not-allowed;
      }
      .wallet--apple {
        background: #000;
        color: #fff;
      }
      .wallet--link {
        background: #00d924;
        color: #fff;
      }
      .wallet--amazon {
        background: #ffd814;
        color: #232f3e;
      }
      .or-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.25rem 0;
        color: #697386;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
      }
      .or-divider::before,
      .or-divider::after {
        content: "";
        flex: 1;
        border-top: 1px solid #dfe3ea;
      }
      .field-label {
        margin: 0 0 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
      }
      .field {
        display: block;
        margin-bottom: 1.5rem;
      }
      .field__label {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.9rem;
        color: #4f566b;
      }
      .field input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem 0.85rem;
        border: 1px solid #cbd2dc;
        border-radius: 6px;
        background: #fff;
        font-size: 1rem;
        color: #1a1f36;
      }
      .field input:disabled {
        background: #f6f9fc;
        color: #697386;
      }
      .pay-methods {
        border: 1px solid #cbd2dc;
        border-radius: 6px;
        background: #fff;
        overflow: hidden;
      }
      .pay-method {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem;
        cursor: not-allowed;
      }
      .pay-method + .pay-method {
        border-top: 1px solid #dfe3ea;
      }
      .pay-method--selected {
        background: #f6f9fc;
      }
      .pay-method__name {
        font-weight: 600;
      }
      .card-marks {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-left: auto;
      }
      .card-mark {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.35rem;
        border: 1px solid #dfe3ea;
        border-radius: 3px;
        background: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        color: #1a1f36;
      }
      .card-mark--visa {
        color: #1a1f86;
        font-style: italic;
      }
      .card-mark--mc i {
        display: block;
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        background: #eb001b;
      }
      .card-mark--mc i + i {
        margin-left: -0.35rem;
        background: #f79e1b;
        opacity: 0.85;
      }
      .card-mark--amex {
        background: #2e77bc;
        color: #fff;
        border-color: #2e77bc;
      }
      .card-mark--disc {
        color: #f48120;
      }
      .cashapp-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.4rem;
        height: 1.4rem;
        margin-left: auto;
        border-radius: 4px;
        background: #00d632;
        color: #fff;
        font-weight: 800;
      }
      .subscribe-btn {
        width: 100%;
        margin-top: 1.5rem;
        border: 0;
        border-radius: 6px;
        background: #635bff;
        color: #fff;
        padding: 0.95rem 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: not-allowed;
      }
      .auth-note {
        margin: 1rem 0 0;
        font-size: 0.85rem;
        line-height: 1.55;
        color: #4f566b;
        text-align: center;
      }
      .stripe-foot {
        margin: 1.25rem 0 0;
        font-size: 0.85rem;
        color: #697386;
        text-align: center;
      }
      .stripe-foot span {
        margin: 0 0.35rem;
      }
      .checkout-nap {
        margin: 2.5rem 0 0;
        font-size: 0.8rem;
        color: #697386;
        text-align: center;
      }
      .checkout-nap a {
        color: #697386;
      }
      .checkout-demo {
        margin: 0.5rem 0 0;
        font-size: 0.8rem;
        color: #697386;
        text-align: center;
      }
      @media (max-width: 47.99em) {
        .checkout-page {
          padding: 1.25rem 1rem 2.5rem;
        }
        .checkout-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .checkout-price__amount {
          font-size: 2.25rem;
        }
        h1 {
          font-size: 1.3rem;
        }
      }
    </style>
  </body>
</html>
