---
// Accordion with no JavaScript: <details>/<summary> is keyboard accessible for free.
// Answers here must match the FAQPage schema text exactly.
interface Props {
  /** Must follow the H2 rules in PLAN.md section 3d. No eyebrow label above it. */
  heading?: string;
  faqs: Array<{ question: string; answer: string }>;
}
const { heading = "Common plumbing questions", faqs } = Astro.props;
---

<section class="section faqs">
  <div class="wrap">
    <h2>{heading}</h2>
    <div class="faqs__list">
      {
        faqs.map((faq) => (
          <details class="faq">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
