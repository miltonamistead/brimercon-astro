---
import type { Service } from "@/data/services";
import ServiceIcon from "./ServiceIcon.astro";

interface Props {
  service: Service;
  /** Show the first N bullets; 0 hides them. */
  bullets?: number;
}
const { service, bullets = 3 } = Astro.props;
const href = `/services/${service.slug}/`;
---

<li>
  <a class="card" href={href}>
    <span class="card__icon" aria-hidden="true">
      <ServiceIcon slug={service.slug} />
    </span>
    <h3 class="card__title">{service.name}</h3>
    <p class="card__summary">{service.summary}</p>
    {
      bullets > 0 && (
        <ul class="card__bullets">
          {service.bullets.slice(0, bullets).map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )
    }
    <span class="card__more">
      Learn more about {service.shortName.toLowerCase()}
      <span class="card__arrow" aria-hidden="true"> →</span>
    </span>
  </a>
</li>
