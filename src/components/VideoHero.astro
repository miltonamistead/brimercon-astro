---
/**
 * VideoHero: homepage-only hero (still-image variant since 2026-10-09).
 *
 * Full-viewport hero with the copy bottom-left over a gradient shade.
 * Previously a looping video reel; Milton asked for the gas-line still
 * (crew + branded truck) as the primary hero image instead.
 * Keeps the data-fs contract markers h1, area and call inside the hero; hours
 * and trust render in the slim strip below so the static QA gate
 * (scripts/qa-first-screen-static.mjs) still sees all five markers in document
 * order. The Playwright fold-position gate (tests/first-screen.spec.ts) carries
 * the homepage hero variant.
 */
import { site, trustPoints } from "@/data/site";
import { ratingSummary } from "@/data/reviews";
import Stars from "@/components/Stars.astro";

const rating = ratingSummary();

// site.afterHoursLine stays the single source of the sentence; splitting on the
// number keeps the markup from wrapping mid-digits on a narrow screen.
const [beforePhone, afterPhone] = site.afterHoursLine.split(site.phoneDisplay);
---

<section class="video-hero" aria-label="Brimer Plumbing introduction">
  <img
    class="video-hero__media"
    src="/video/hero-poster.jpg"
    alt="Brimer Plumbing technicians installing a gas line at a snowy Truckee cabin, branded service van parked nearby."
    fetchpriority="high"
    decoding="async"
  />
  <div class="video-hero__shade" aria-hidden="true"></div>

  <div class="wrap video-hero__content">
    <h1 class="video-hero__h1" data-fs="h1">
      Plumber in Truckee and North Lake Tahoe. Water heaters, gas service, and repairs.
    </h1>
    <p class="video-hero__kicker" data-fs="area">
      <a href="/service-areas/">Serving Truckee and North Lake Tahoe since 1997</a>
    </p>
    <p class="video-hero__sub">Got a problem? We'll fix it. Got an idea? We'll make it happen.</p>
    <a class="btn-call video-hero__call" href={site.phoneHref} data-fs="call">
      <span aria-hidden="true">&#9742;</span>
      <span>Call {site.phoneDisplay}</span>
    </a>
    <a class="video-hero__form-link" href="/request-service/" data-fs="form-link">Or send a service request</a>
  </div>
</section>

<section class="video-hero__strip" aria-label="Hours and credentials">
  <div class="wrap">
    <p class="video-hero__hours" data-fs="hours">
      {site.hoursLabel}. {beforePhone}<span class="nowrap">{site.phoneDisplay}</span>{afterPhone}
    </p>
    <ul class="trust-strip" data-fs="trust">
      {trustPoints.map((point) => <li>{point.label}</li>)}
      <li>
        <a class="rating" href={site.googleReviewsUrl} rel="noopener">
          {
            rating ? (
              <>
                <Stars rating={rating.rating} />
                <span class="nowrap">{rating.display} from {rating.total} Google reviews</span>
              </>
            ) : (
              "Google reviews"
            )
          }
        </a>
      </li>
    </ul>
  </div>
</section>
