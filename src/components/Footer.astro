---
import { site, navPrimary, serviceAreaGroups } from "@/data/site";
import { services } from "@/data/services";
import TownLink from "@/components/TownLink.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <h2>{site.name}</h2>
        <address>
          {site.street}<br />
          {site.city}, {site.region} {site.postal}
        </address>
        <p>
          <a href={site.phoneHref}>{site.phoneDisplay}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p>{site.hoursLabel}.<br />{site.afterHoursLine}</p>
        <p>
          <a href={site.mapsUrl} rel="noopener">Find us on Google Maps</a>
        </p>
      </div>

      <div>
        <h2>Services</h2>
        <ul class="site-footer__services">
          {services.map((service) => <li><a href={`/services/${service.slug}/`}>{service.shortName}</a></li>)}
        </ul>
      </div>

      <div>
        <h2>Service areas</h2>
        {
          serviceAreaGroups.map((group) => (
            <div class="site-footer__group-block">
              <p class="site-footer__group">{group.label}</p>
              <ul class="site-footer__towns">
                {group.towns.map((slug) => <TownLink slug={slug} />)}
              </ul>
            </div>
          ))
        }
        <p><a href="/service-areas/">All service areas</a></p>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>{site.cslbLine}</p>
      <nav class="site-footer__legal-links" aria-label="Legal">
        {navPrimary.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/privacy-policy/">Privacy Notice</a>
        <a href="/terms-of-use/">Terms of Use</a>
      </nav>
      <p>&copy; {year} {site.legalName} dba {site.dba}. Established {site.founded}.</p>
    </div>
  </div>
</footer>
