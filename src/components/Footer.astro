---
import { site, serviceAreaGroups } from "@/data/site";
import { getTown, towns } from "@/data/towns";

// Four-column footer (Milton spec, 2026-10-20): brand and contact, a short Services
// list, Service areas, Company links with the Request Service button, and a slim
// bottom bar.
//
// The Service areas column lists all 24 towns, grouped by service area, because the
// town pages need sitewide links (audit H4): with only five towns here, sixteen town
// pages were linked from two to four pages each. Groups, order and names come from
// serviceAreaGroups (site.ts) and towns (towns.ts), so a town added there appears
// here. The build fails if any town is missing from the groups or listed twice.
const year = new Date().getFullYear();

const footerServices = [
  { label: "Water Heaters", href: "/services/water-heaters/" },
  { label: "Drain Cleaning", href: "/services/drain-cleaning/" },
  { label: "Leak Detection", href: "/services/leak-detection/" },
  { label: "Gas Services", href: "/services/gas-services/" },
  { label: "Kitchen & Bath", href: "/services/kitchen-bath-plumbing/" },
  { label: "Frozen & Burst Pipes", href: "/services/frozen-burst-pipes/" },
  { label: "Emergency Plumber", href: "/services/emergency-plumber/" },
];

const footerAreaGroups = serviceAreaGroups.map((group) => ({
  label: group.label,
  hub: "hub" in group ? group.hub : undefined,
  towns: group.towns.map((slug) => {
    const town = getTown(slug);
    if (!town) throw new Error(`Footer: serviceAreaGroups names "${slug}", which is not in towns.ts`);
    return { label: town.name, href: `/service-areas/${town.slug}/` };
  }),
}));

const footerTownHrefs = footerAreaGroups.flatMap((group) => group.towns.map((town) => town.href));
if (footerTownHrefs.length !== towns.length || new Set(footerTownHrefs).size !== towns.length) {
  throw new Error(
    `Footer: expected each of the ${towns.length} towns exactly once, got ${footerTownHrefs.length} links (${new Set(footerTownHrefs).size} unique)`,
  );
}

const footerCompany = [
  { label: "About", href: "/about/" },
  { label: "Reviews", href: "/reviews/" },
  { label: "Blog", href: "/blog/" },
  { label: "FAQs", href: "/faqs/" },
  { label: "Resources", href: "/resources/" },
  { label: "Membership", href: "/membership/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy Notice", href: "/privacy-policy/" },
  { label: "Terms of Use", href: "/terms-of-use/" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label={`${site.name} home`}>
          <img class="site-footer__logo" src="/images/brimer-logo.png" alt={site.name} width="564" height="210" />
        </a>
        <p class="site-footer__tagline">
          Serving Truckee and North Lake Tahoe since 1997. Licensed plumbing contractors delivering finish-first standards for mountain homes.
        </p>
        <p class="site-footer__contact-line">
          <span aria-hidden="true">&#9742;</span>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </p>
        <p class="site-footer__contact-line">
          <span aria-hidden="true">&#9993;</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="site-footer__meta">
          {site.street}, {site.city}, {site.region} {site.postal}<br />
          Open 7:00 AM to 8:00 PM, every day<br />
          <a href={site.mapsUrl} rel="noopener">Find us on Google Maps</a>
        </p>
      </div>

      <nav aria-label="Footer services">
        <h2 class="site-footer__heading">Services</h2>
        <ul class="site-footer__list">
          {footerServices.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__areas-nav" aria-label="Footer service areas">
        <h2 class="site-footer__heading">Service areas</h2>
        <div class="site-footer__areas">
          {
            footerAreaGroups.map((group) => (
              <div class="site-footer__group">
                <p class="site-footer__group-label">
                  {group.hub ? <a href={group.hub}>{group.label}</a> : group.label}
                </p>
                <ul class="site-footer__list">
                  {group.towns.map((town) => <li><a href={town.href}>{town.label}</a></li>)}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="site-footer__all-areas"><a href="/service-areas/">All Areas</a></p>
      </nav>

      <nav aria-label="Footer company">
        <h2 class="site-footer__heading">Company</h2>
        <ul class="site-footer__list">
          {footerCompany.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <a class="site-footer__request" href="/request-service/">Request Service</a>
      </nav>
    </div>

    <div class="site-footer__bar">
      <p>&copy; {year} Brimer Plumbing. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/">Privacy Notice</a> &middot; <a href="/terms-of-use/">Terms of Use</a> &middot; CA CSLB License #: 1149344 &middot; Licensed in California only. Not licensed in Nevada.
      </p>
    </div>
  </div>
</footer>
