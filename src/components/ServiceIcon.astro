---
/**
 * Line icons for the service cards, one per service slug.
 * Blanton-style: simple 24x24 stroke icons, currentColor.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const ICONS: Record<string, string> = {
  "water-heaters":
    '<path d="M8 21v-9a4 4 0 0 1 8 0v9"/><path d="M5 21h14"/><path d="M10 8V4M14 8V4"/><path d="M10 4h4"/>',
  "tankless-water-heaters":
    '<rect x="7" y="11" width="10" height="8" rx="1.5"/><path d="M9.5 7.5c0-1.2 1-1.3 1-2.5M12.5 7.5c0-1.2 1-1.3 1-2.5M15.5 7.5c0-1.2 1-1.3 1-2.5"/>',
  winterization:
    '<path d="M12 3v18M5 7l14 10M19 7L5 17"/><path d="M12 3l-1.8 1.8M12 3l1.8 1.8M12 21l-1.8-1.8M12 21l1.8-1.8"/>',
  "drain-cleaning":
    '<circle cx="12" cy="12" r="8"/><path d="M12 8.5A3.5 3.5 0 1 1 8.5 12"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  "leak-detection":
    '<circle cx="10.5" cy="10.5" r="6"/><path d="m15.2 15.2 4.8 4.8"/><path d="M10.5 8.2c.9 1.1 1.6 2 1.6 2.9a1.6 1.6 0 1 1-3.2 0c0-.9.7-1.8 1.6-2.9z"/>',
  "emergency-plumber":
    '<path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  "frozen-burst-pipes":
    '<path d="M2 12h6M16 12h6"/><path d="M12 5.5 13.2 8l2.6.4-1.9 1.8.5 2.6-2.4-1.2-2.4 1.2.5-2.6L8.2 8.4l2.6-.4z"/>',
  "gas-services":
    '<path d="M12 21.5c3.8 0 6.5-2.6 6.5-6.2 0-3.8-3.2-5.6-4.3-9-1.9 1.4-2.7 3-2.9 4.7-.7-.4-1.2-1.2-1.4-2.3C8.5 10.1 8 11.5 8 13.3c0 4.6 1.4 8.2 4 8.2z"/>',
  "kitchen-bath-plumbing":
    '<path d="M5 11h7v2.5"/><path d="M12 11V9a3 3 0 0 1 3-3h5"/><path d="M20 6v5"/><path d="M7 11v8"/><path d="M4.5 21h5"/>',
  "appliance-installation":
    '<rect x="5" y="3" width="14" height="18" rx="2"/><circle cx="12" cy="13.5" r="4.5"/><circle cx="12" cy="13.5" r="1.2" fill="currentColor" stroke="none"/><path d="M8.5 6.5h.01M11.5 6.5h.01"/>',
  "smart-leak-shutoff":
    '<path d="M12 3l7 2.8v6.1c0 3.9-3 6.4-7 8.1-4-1.7-7-4.2-7-8.1V5.8z"/><path d="M12 9.3c.8 1 1.4 1.9 1.4 2.7a1.4 1.4 0 1 1-2.8 0c0-.8.6-1.7 1.4-2.7z"/>',
};

const FALLBACK =
  '<path d="M14.5 6.5a4 4 0 0 0-5.6 5L4 16.4V20h3.6l4.9-4.9a4 4 0 0 0 5-5.6l-2.7 2.7-2.5-.7-.7-2.5z"/>';
const inner = ICONS[slug] ?? FALLBACK;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <Fragment set:html={inner} />
</svg>
