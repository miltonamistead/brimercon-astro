---
// Ported from the live Privacy Notice (docs/crawl/pages/privacy-policy.txt), with the
// substance unchanged. Two factual corrections for what this build actually does: the
// twin loads no Google Analytics or Tag Manager unless PUBLIC_GA4_ID is set, and lead
// submissions go to Brimer's own email and record store rather than GoHighLevel.
import Base from "@/layouts/Base.astro";
import { site, napOneLine } from "@/data/site";

const title = "Privacy Notice | Brimer Plumbing | Truckee & North Lake Tahoe";
const description =
  "How Brimer Plumbing collects, uses, and shares information when you visit the site, contact us, or request plumbing service.";
const analyticsEnabled = Boolean(import.meta.env.PUBLIC_GA4_ID);
---

<Base title={title} description={description}>
  <section class="section">
    <div class="wrap prose">
      <h1>Privacy Notice</h1>
      <p class="lede">
        This notice explains what information Brimer Plumbing collects, how we use it, and the choices you have.
      </p>
      <p><strong>Last updated:</strong> September 19, 2026</p>
      <p>
        Brimer Plumbing, operated by {site.legalName}, respects your privacy. This notice describes how we collect,
        use, and share information when you visit our website, contact us, or request plumbing service.
      </p>

      <h2>What we collect</h2>
      <p>Information you give us directly through the service request or contact form:</p>
      <ul>
        <li>Your name</li>
        <li>Phone number</li>
        <li>Email address, if you choose to give one</li>
        <li>Service address and town, if you choose to give them</li>
        <li>What you tell us about the plumbing problem</li>
      </ul>
      <p>
        We also record the page the request came from, your browser's user agent, and a one-way hashed form of your IP
        address used only to limit abuse. We do not store your IP address itself.
      </p>

      <h2>How we use it</h2>
      <ul>
        <li>To respond to your enquiry and to schedule, carry out, and follow up on plumbing work</li>
        <li>To contact you by phone, text message, or email about your request or appointment</li>
        <li>To meet legal obligations and to protect our rights</li>
      </ul>

      <h2>Text messages and calls</h2>
      <p>
        If you give us your phone number we may call or text you about your request, scheduling, and the work itself.
        Message and data rates may apply. You can opt out of text messages at any time by replying STOP, or get help by
        replying HELP. Opting out of marketing messages does not affect texts needed to complete work you asked for.
        Mobile information is not shared with third parties for their own marketing.
      </p>

      <h2>Cookies and analytics</h2>
      {
        analyticsEnabled ? (
          <p>
            We use Google Analytics to understand how visitors use the site. It may collect pages visited, time on
            site, and general location. You can control cookies through your browser settings.
          </p>
        ) : (
          <p>
            This site sets no analytics or advertising cookies and loads no third-party tracking scripts. Nothing here
            follows you to another website.
          </p>
        )
      }

      <h2>Who else sees your information</h2>
      <p>
        Service request details are delivered to Brimer Plumbing by email and stored in a record system we control. We
        use a transactional email provider to deliver those messages. We do not sell your information, and we do not
        share it for anyone else's marketing.
      </p>

      <h2>Keeping it</h2>
      <p>
        We keep service request records for as long as we need them to run the business and meet legal and tax
        obligations, then delete them.
      </p>

      <h2>Your choices</h2>
      <p>
        You can ask us what we hold about you, ask us to correct it, or ask us to delete it. California residents have
        rights under the CCPA, including the right to know, delete, and not be discriminated against for exercising
        them. We do not sell personal information.
      </p>

      <h2>Contact us</h2>
      <p>
        {site.name}, {napOneLine()}.<br />
        <a href={`mailto:${site.email}`}>{site.email}</a> or <a href={site.phoneHref}>{site.phoneDisplay}</a>.
      </p>
    </div>
  </section>
</Base>
