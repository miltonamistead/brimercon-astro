---
// Confirmation for a no-JavaScript submit. Always noindex, and it exists on live too
// (200, noindex), so reusing the path keeps the URL map honest.
import Base from "@/layouts/Base.astro";
import FirstScreen from "@/components/FirstScreen.astro";
import { site } from "@/data/site";

const ref = Astro.url.searchParams.get("ref");
---

<Base
  title={`Request received | ${site.name}`}
  description="We have your service request and will get back to you."
  noindex
>
  <FirstScreen
    h1="Request received"
    intro="We will review your request and get back to you. If this is an emergency, calling is faster than waiting for a reply."
    formLabel="Send another request"
  />

  <section class="section">
    <div class="wrap">
      <h2>What happens next</h2>
      <p>
        Expect a call or an email within one business day. {site.afterHoursLine}
      </p>
      {ref && <p class="nap-line">Your reference is <strong>{ref}</strong>. Quote it if you call before we reach you.</p>}
      <p><a href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
