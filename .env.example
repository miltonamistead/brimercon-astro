# ---- Indexing (PLAN.md §5) -------------------------------------------------
# Staging stays noindex. Only the swap runbook flips this, together with the
# X-Robots-Tag block in vercel.json (two independent keys).
PUBLIC_INDEXABLE=false

# Canonical host the twin points at. Do not change for staging.
PUBLIC_CANONICAL_ORIGIN=https://www.brimercon.com

# Analytics (audit B2). Unset = no tag and no third-party script at all. Set it to the
# GA4 measurement ID to load GA4 with phone_call_click and generate_lead events.
# Production today uses G-JN4WLJHEZJ. Left unset on staging by default so live GA4 is
# not polluted (decision D7); set it there only for the short proof test.
# PUBLIC_GA4_ID=

# ---- Google rating (docs/design.md section 3) -------------------------------
# Used only by `npm run reviews`, which refreshes src/data/reviews-cache.json and is
# committed. The site build never calls the API, so a Places outage cannot break a deploy.
# Restrict the key to the Places API. rating, userRatingCount and reviews are all
# Place Details Enterprise SKU fields.
GOOGLE_PLACES_API_KEY=

# ---- Lead delivery (docs/lead-capture.md §3–4) ------------------------------
# Email via Resend HTTP API. Leave empty to skip email.
RESEND_API_KEY=
LEAD_TO_EMAIL=service@brimerplumbing.com
# onboarding@resend.dev is Resend's shared test sender. Before cutover, verify a Brimer
# domain in Resend and send from an address on it (runbook decision D5).
LEAD_FROM_EMAIL=Brimer Website <onboarding@resend.dev>
# LEAD_CC_EMAIL=

# Generic JSON webhook (GHL inbound webhook, Zapier/Make, Sheets Apps Script, ...).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Store: "file" for local QA only (Vercel filesystem is ephemeral); "none" on Vercel.
LEAD_STORE=file
LEAD_STORE_PATH=.data/leads.jsonl

# Keep this true everywhere a customer can reach the form (audit B1). With true, a lead
# that no real channel accepts fails loudly and the page tells the person to call.
# With false and no channel set, the endpoint answers success and the lead goes
# nowhere. Unset behaves as true. Set false only for local QA with LEAD_STORE=file.
LEAD_REQUIRE_DELIVERY=true

# Label written into every lead record.
LEAD_SITE_LABEL=brimercon-astro-staging
